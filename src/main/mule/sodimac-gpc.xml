	<flow name="Sodimac-OC-GPC" doc:id="eafeb0df-72cd-454a-a194-a6434145c4f3" maxConcurrency="1" >
		<pubsub:message-listener doc:name="On message listener" doc:id="4201d77a-1546-4d44-8eb5-ed05f0172e44" config-ref="Google_Pub_Sub_Configuration" projectId="${secure::SodimacGCP.projectId}" subscriptionName="${secure::SodimacGCP.subscriptionName}" acknowledgmentMode="MANUAL"/>
		<logger level="INFO" doc:name="START" doc:id="a0333abf-09e9-4007-b903-3ebe704b22d8" message="START"/>
		<logger level="DEBUG" doc:name="attributes" doc:id="1eef8671-be6c-499e-8282-9643c5d70821" message="#[%dw 2.0&#10;output application/json&#10;---&#10;message.attributes]"/>
		<logger level="DEBUG" doc:name="payload" doc:id="5feeb0ce-ffc0-4662-87b8-62f96018c4d1" message="#[%dw 2.0&#10;output application/json&#10;---&#10;payload]" />
		<ee:transform doc:name="Init vars" doc:id="67fb7a4e-565c-4ff7-ba8d-e47f06718e48" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="oc" ><![CDATA[%dw 2.0
output application/json
---
read(payload,"application/json")]]></ee:set-variable>
				<ee:set-variable variableName="ackId" ><![CDATA[%dw 2.0
output application/json
---
message.attributes.ackId]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<logger level="INFO" doc:name="OC" doc:id="7843dda8-fa93-45db-8610-84573f1b4ba8" message='#["OC " ++ vars.oc.backOrder.originalOrderNumber]' />
		<try doc:name="Try" doc:id="8cfd09ee-d160-4f63-9be2-73df3fe14c45" >
			<ee:transform doc:name="Format SF" doc:id="b1262ab3-c844-4b4b-a785-c61a60dc36fa" >
				<ee:message />
				<ee:variables >
					<ee:set-variable variableName="ocToSf" ><![CDATA[%dw 2.0
output application/json

fun trunc130 (value) = if((!isEmpty(value)) and (sizeOf(value) > 130000)) value[0 to 130000] else value
---
[{
	"Name": "Mulesoft - Lectura GPC Sodimac",
	"Url_servicio__c": "fal-corp-mrch-prchord-prod - prch-provider-volcan",
	"ExternalID__c": "Sodimac-GCP-" ++ vars.oc.backOrder.originalOrderNumber,
    "Error_Message__c": "200",
    "RespuestaServicio__c": trunc130(payload),
    "PeticionServicio__c": "Sodimac-GCP-" ++ vars.oc.backOrder.originalOrderNumber
}]]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
			<logger level="DEBUG" doc:name="ocToSf" doc:id="46fa918d-0ea5-47ab-9772-501c65dc4be3" message="#[vars.ocToSf]" />
			<salesforce:create type="Log__c" doc:name="Create" doc:id="aa6448d9-00b0-4600-9794-c51663ca4244" config-ref="Salesforce_Config" >
				<salesforce:records ><![CDATA[#[vars.ocToSf]]]></salesforce:records>
			</salesforce:create>
			<logger level="DEBUG" doc:name="Response payload" doc:id="84280ee9-abf5-466c-b3bf-95bf20a21f3c" message="#[%dw 2.0&#10;output application/json&#10;---&#10;payload]" />
			<pubsub:acknowledge-message doc:name="Acknowledge Message" doc:id="6ec13499-5e9e-47f7-91ac-f04517343179" ackId="#[vars.ackId]" config-ref="Google_Pub_Sub_Configuration">
				<reconnect frequency="5000" count="3" />
			</pubsub:acknowledge-message>
			<error-handler >
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="72edf4a6-2750-4a30-958c-7b2a83516b74" >
