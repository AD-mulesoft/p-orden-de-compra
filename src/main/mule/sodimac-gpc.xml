				</on-error-continue>
			</error-handler>
		</try>
		<choice doc:name="Choice" doc:id="73cc117e-8298-45fc-947e-eeb52cc1ce35" >
			<when expression='#[((vars.oc.purchaseOrderInfo.statusId as String) == "1") and (vars.oc.purchaseOrderInfo."type" != "Compra Directa")]'>
				<ee:transform doc:name="sfOrderId" doc:id="b7c84ac4-ab38-49b9-af0b-39e2a312afec">
					<ee:message>
					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="sfOrderId" ><![CDATA[%dw 2.0
output application/json
---
"SELECT Id FROM Order WHERE VM_NumeroOC__c = '" ++ (vars.oc.backOrder.originalOrderNumber default "XXXXXXX") ++ "' AND Account.Cod_Cliente__c = '0005000463' AND IsDeleted = false"]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<logger level="INFO" doc:name="sfOrderId" doc:id="79c9ff28-78bf-4354-b57b-62a5125f7f20" message="#[%dw 2.0&#10;output application/json&#10;---&#10;vars.sfOrderId]" />
				<salesforce:query-all doc:name="Query all" doc:id="1527e81e-f82e-4569-aec3-63d848c3d5d1" config-ref="Salesforce_Config" target="sfOrderId">
					<salesforce:salesforce-query><![CDATA[#[vars.sfOrderId]]]></salesforce:salesforce-query>
				</salesforce:query-all>
				<logger level="INFO" doc:name="sfOrderId" doc:id="f0adf554-a3d7-4245-bb68-8184b499fba0" message="#[%dw 2.0&#10;output application/json&#10;---&#10;vars.sfOrderId]" />
				<choice doc:name="Choice" doc:id="104e8ce8-c3a5-4cec-af12-c5a511c490f8">
					<when expression="#[isEmpty(vars.sfOrderId)]">
						<logger level="INFO" doc:name="NUEVO" doc:id="8d92eb28-ca24-4a4b-95a3-babe3f990da5" message="NUEVA OC" />
						<logger level="INFO" doc:name="Send to SF" doc:id="d9725dc9-3368-4d6a-9cf0-2dc4087b8a88" message="Send to SF" />
						<ee:transform doc:name="Format OC SF" doc:id="1b96e6ba-1ae5-4978-9671-d491001a43e6">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="orderResponseIDP"><![CDATA[%dw 2.0
import leftPad from dw::core::Strings
output application/json

var CFV = ["Rep Tienda Multiple Despachos","Rep Tienda Acepta un Despacho","Rep Central Volumen","Compra Directa"]
var RET = ["Compra contra Pedido","Cross Docking"]
var LO = ["Rep Tienda Multiple Despachos","Rep Tienda Acepta un Despacho","Rep Central Volumen","Compra contra Pedido","Compra Directa"]
var XD = ["Cross Docking"]
var body = vars.oc.products
---
{
    "esOrden": true,
    "numeroOrden": vars.oc.backOrder.originalOrderNumber default "",
    "fecha": vars.oc.purchaseOrderInfo.creationDate default "",
    "rutVolcan": vars.oc.vendor.taxIdNumber default "",
    "nombreVolcan": vars.oc.vendor.vendorName default "",
    "rutSolicitante": "96792430-K",
    "nombreSolicitante": "Sodimac S.A.",
//    "direccionDespachar": (vars.eOD filter ($.items[0].NRO_OC == body[0].NRO_OC))[0].items[0].DIREC_L_ENTREGA,
    "canal": "10",
    "incoterms1": if(CFV contains vars.oc.purchaseOrderInfo."type") "CFV" else if(RET contains vars.oc.purchaseOrderInfo."type") "RET" else "N/A",
    "condicionPago": ("C" ++ leftPad(vars.oc.paymentTerms.days as String, 3, "0")) default "",
//    "nombreDestinatario": (vars.oc.purchaseOrderInfo.costCenterName splitBy " ")[0 to 1] joinBy "-",
    "nombreDestinatario": leftPad((vars.oc.purchaseOrderInfo.costCenter as String),2,"0"),
    "tipoOC": if(LO contains vars.oc.purchaseOrderInfo."type") "LO" else if(XD contains vars.oc.purchaseOrderInfo."type") "XD" else "N/A",
    "fechaValidoDe": if(vars.oc.purchaseOrderInfo.costCenter as String == "257") (vars.oc.purchaseOrderInfo.creationDate default "") else (vars.oc.purchaseOrderInfo.eta default ""),
    "fechaValidezA": if(vars.oc.purchaseOrderInfo.costCenter as String == "257") (vars.oc.purchaseOrderInfo.eta default "") else (vars.oc.purchaseOrderInfo.lrd default ""),
    "items": body map (item,index) -> {
        "cantidad": item.allocations[0].purchasedUnits as String default "",
        "unidad": item.logisticVariable.measurementUnit default "",
        "codigo": item.sku default "",
        "descripcion": item.description default "",
        "precioUnitario": item.catalogCost as String default "",
        "precioTotal": ((item.catalogCost as Number) * (item.allocations[0].purchasedUnits as Number)) as String default ""
    },
    "conversationId": "",
    "source": "GCP",
    "subject": "",
    "fileName": ""
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
						<logger level="DEBUG" doc:name="orderResponseIDP" doc:id="7d615d56-aab0-43de-ad27-2208852c17a5" message="#[vars.orderResponseIDP]" />
						<flow-ref doc:name="create-order-in-salesforce" doc:id="d30e18d2-f66f-4351-9bec-4511b5cc00e5" name="create-order-in-salesforce" />
					</when>
					<otherwise >
						<logger level="INFO" doc:name="EXISTE" doc:id="b2fe6347-8bd9-4c10-b2ff-19ca7859542b" message="EXISTE OC" />
					</otherwise>
				</choice>
			</when>
			<otherwise >
				<logger level="INFO" doc:name="Invalid status" doc:id="9a22c788-0340-422a-a834-3c3a9c49db22" message='#["Invalid status: " ++ (vars.oc.purchaseOrderInfo.statusId as String) ++ " - or Type: " ++ (vars.oc.purchaseOrderInfo."type" as String)]' />
			</otherwise>
		</choice>
		<logger level="INFO" doc:name="END" doc:id="39523a32-591f-4414-a267-96c6535ce498" message="END"/>
	</flow>
