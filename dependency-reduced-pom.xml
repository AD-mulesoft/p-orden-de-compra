      <artifactId>mule-plugin-idp-action-dc55b47f-c0e3-4f12-9673-6408bf795586</artifactId>
      <version>1.2.0</version>
      <classifier>mule-plugin</classifier>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>fb08f1b2-681f-464c-a65e-2cc87a97acfd</groupId>
